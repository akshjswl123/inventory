# Copy to .env — docker compose reads this automatically.

# mcp_reader password (must match scripts/28_mcp_reader_role.sql if you change it).
MCP_READER_PASSWORD=McpReadOnly_ChangeMe2026

# --- MCP HTTP (postgres-mcp service) ---
# Host IP/interface to publish on the machine running Docker:
#   127.0.0.1     = only this machine (default)
#   0.0.0.0       = all interfaces (LAN clients can connect)
#   192.168.1.20  = bind to one NIC
MCP_HTTP_BIND=127.0.0.1
MCP_HTTP_PORT=5000

# --- CLIENT (Cursor on another laptop/phone) ---
# Do not use host.docker.internal. Point at the SERVER that runs compose:
#   LAN:        http://<server-lan-ip>:5000/mcp   (set MCP_HTTP_BIND=0.0.0.0 on server)
#   Cloudflare: ./scripts/print-mcp-client-json.sh  (on server, after tunnel-mcp is up)
# Paste into .cursor/mcp.json on the client machine only.
